# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is now read ONLY by the backend server (server/index.ts) and is
# never bundled into the browser JS, unlike the previous version of this app.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port the backend API server listens on. Defaults to 8787.
PORT=8787

# ADMIN_TOKEN: Optional. If set, GET /api/reports requires this value in an
# `x-admin-token` header to view submitted "report an issue" entries. If
# unset, that endpoint is disabled (returns 404).
ADMIN_TOKEN=""

# REPORT_WEBHOOK_URL: Optional. If set, every "report an issue" submission
# is also POSTed here (e.g. a Slack incoming webhook URL) so a real person
# gets notified right away instead of only checking /api/reports manually.
REPORT_WEBHOOK_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
